{
  "name": "@aftal/ui",
  "version": "0.1.0",
  "description": "Aftal design system - tokens, fonts and React components for the 2026 brand",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "styles.css",
    "tokens",
    "components",
    "assets",
    "DESIGN.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aftal-dk/aftal-ui.git"
  }
}
