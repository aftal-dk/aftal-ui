{
  "name": "@aftal/ui",
  "version": "0.2.0",
  "description": "Aftal design system - tokens, fonts and React components for the Aftal brand",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "styles.css",
    "tokens",
    "components",
    "assets",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aftal-dk/aftal-ui.git"
  },
  "types": "index.d.ts"
}
